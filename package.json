{
  "name": "@markxroberts/risco-lan-bridge",
  "displayName": "Risco Lan Bridge",
  "version": "0.17.0",
  "typings": "dist/index.d.ts",
  "description": "Risco Lan Bridge allows direct communication with most Risco control panels. It allows you to recover in real time the state of your system and to perform the arming/disarming functions or the inhibition of the detection zones.",
  "directories": {
    "doc": "doc",
    "example": "examples",
    "lib": "dist"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markxroberts/risco-lan-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/markxroberts/risco-lan-bridge/issues"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "watch": "tsc -w",
    "lint": "eslint src test",
    "test": "npm run test:unit",
    "test:unit": "jest --runInBand --silent --testPathIgnorePatterns=test/main.test.ts",
    "test:integration": "jest --runInBand test/main.test.ts",
    "testw": "jest --watch --testPathIgnorePatterns=test/main.test.ts",
    "start": "npm run build && node ./dist/main.js",
    "prepublishOnly": "npm run lint && npm run build && npm run typecheck:test && npm test",
    "typecheck:test": "tsc --project tsconfig.test.json"
  },
  "keywords": [
    "risco",
    "lan",
    "alarm",
    "tcp/ip",
    "agility",
    "wicomm",
    "wicommpro",
    "lightsys",
    "prosysplus",
    "gtplus"
  ],
  "author": "Mark Roberts <mark.roberts30@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/markxroberts/risco-lan-bridge#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "tiny-typed-emitter": "^2.1.0",
    "tslib": "^2.8.1",
    "js-yaml": "^5.5.0"
  },
  "main": "dist/index.js"
}
